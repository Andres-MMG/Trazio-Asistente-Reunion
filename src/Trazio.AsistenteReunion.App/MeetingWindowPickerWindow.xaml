<Window x:Class="Trazio.AsistenteReunion.App.MeetingWindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Seleccionar ventana de reunión" Height="520" Width="860" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Seleccionar ventana de reunión" FontSize="21" FontWeight="SemiBold" Foreground="#14213D"/>
            <TextBlock Text="Trazio consultará las ventanas visibles solo cuando pulses “Actualizar lista”. El título y la aplicación se usan solo dentro de este selector y se descartan al asociar o cerrar: no se guardan, no se capturan imágenes y la captura de audio seguirá usando los dispositivos configurados."
                       TextWrapping="Wrap" Foreground="#556070" Margin="0,5,0,10"/>
            <DockPanel>
                <Button x:Name="RefreshWindowsButton" DockPanel.Dock="Left" Content="Actualizar lista" Click="RefreshWindows_Click"
                        automation:AutomationProperties.Name="Actualizar lista de ventanas visibles"/>
                <TextBlock x:Name="PickerStatusText" Text="Pulsa Actualizar lista para consultar las ventanas visibles."
                           VerticalAlignment="Center" Foreground="#556070" TextWrapping="Wrap" Margin="10,0,0,0"
                           automation:AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </StackPanel>
        <ListView Grid.Row="1" x:Name="WindowList" SelectionChanged="WindowList_SelectionChanged"
                  automation:AutomationProperties.Name="Ventanas disponibles para asociar">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Título transitorio" Width="360" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Aplicación" Width="150" DisplayMemberBinding="{Binding ApplicationName}"/>
                    <GridViewColumn Header="Proveedor detectado" Width="145" DisplayMemberBinding="{Binding ProviderName}"/>
                    <GridViewColumn Header="Minimizada" Width="85" DisplayMemberBinding="{Binding MinimizedName}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True"/>
            <Button x:Name="AssociateWindowButton" DockPanel.Dock="Right" Content="Asociar" IsDefault="True"
                    IsEnabled="False" Click="AssociateWindow_Click"
                    automation:AutomationProperties.Name="Asociar ventana seleccionada"/>
        </DockPanel>
    </Grid>
</Window>
