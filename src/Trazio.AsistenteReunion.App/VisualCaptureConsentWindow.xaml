<Window x:Class="Trazio.AsistenteReunion.App.VisualCaptureConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Autorizar análisis visual" Height="390" Width="590" MinHeight="360" MinWidth="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Autorizar análisis visual" FontSize="22" FontWeight="SemiBold" Foreground="#14213D"/>
            <TextBlock Text="Esta autorización sirve solo para la sesión actual y para la ventana que seleccionaste."
                       TextWrapping="Wrap" Foreground="#556070" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,12">
            <StackPanel automation:AutomationProperties.Name="Condiciones del análisis visual">
                <TextBlock Text="Trazio accederá temporalmente solo a la ventana seleccionada." TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="• No grabará video ni guardará imágenes." TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="• Puedes pausar o detener el análisis visual cuando quieras." TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="• Si el análisis visual falla, el audio y la transcripción continuarán." TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="• Esta versión todavía no identifica hablantes." TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="La autorización no se guarda ni se reutiliza en otra reunión."
                           TextWrapping="Wrap" Foreground="#556070" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="_Cancelar" IsCancel="True" IsDefault="True"
                    automation:AutomationProperties.Name="Cancelar autorización de análisis visual"/>
            <Button x:Name="AuthorizeButton" DockPanel.Dock="Right" Content="_Autorizar análisis visual"
                    Click="Authorize_Click"
                    automation:AutomationProperties.Name="Autorizar análisis visual solo para esta sesión"/>
        </DockPanel>
    </Grid>
</Window>
