<Window x:Class="Trazio.AsistenteReunion.App.AnonymousVisualAnalysisConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Autorizar análisis visual anónimo" Height="560" Width="650" MinHeight="530" MinWidth="610"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Autorizar análisis visual anónimo" FontSize="22" FontWeight="SemiBold" Foreground="#14213D"/>
            <TextBlock Text="Esta autorización sirve una sola vez, solo para la sesión actual y para la ventana elegida."
                       TextWrapping="Wrap" Foreground="#556070" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,12">
            <StackPanel automation:AutomationProperties.Name="Condiciones del análisis visual anónimo">
                <TextBlock Text="Trazio analizará temporalmente solo la ventana elegida, normalmente 1 vez por segundo y nunca más de 2."
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="• No identifica personas ni rostros, y no lee nombres, chat, subtítulos ni documentos."
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="• No guarda imágenes ni video." TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="• Solo guarda, cifrados, intervalos derivados de actividad y disponibilidad. Se borran con la sesión y todavía no se exportan."
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="• Pausar o detener la captura visual no afecta el audio ni la transcripción."
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="• Los perfiles actuales de Google Meet y Microsoft Teams están en validación: pueden abstenerse o mostrar que la evidencia visual no está disponible."
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="La autorización no se guarda ni se reutiliza en otra reunión."
                           TextWrapping="Wrap" Foreground="#556070" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="_Cancelar" IsCancel="True" IsDefault="True"
                    automation:AutomationProperties.Name="Cancelar autorización de análisis visual anónimo"/>
            <Button x:Name="AuthorizeButton" DockPanel.Dock="Right" Content="_Autorizar análisis anónimo"
                    Click="Authorize_Click"
                    automation:AutomationProperties.Name="Autorizar análisis visual anónimo solo para esta sesión"/>
        </DockPanel>
    </Grid>
</Window>
